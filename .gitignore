# Ignore environment secrets
env/.env

# Ignore Python cache and virtualenv
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.env/

# Ignore Manim generated files
media/
app/data/
*.mp4
*.png
*.svg
*.log
generated_scene.py

# Ignore IDE files
.vscode/
.idea/

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore all files inside static except placeholder
app/static/*
!app/static/.gitkeep
.env

# Frontend is a separate repo — do not commit nested vizion-ui/
vizion-ui/
