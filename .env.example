# Vizion backend — copy to .env and fill in values

# production | development
ENV=development

# --- Supabase (hosted project: https://supabase.com/dashboard) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# --- LLM (Groq free tier: https://console.groq.com) ---
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3-32b

# --- Frontend URL (for CORS + Stripe redirects) ---
FRONTEND_URL=http://localhost:8080
# Optional extra origins, comma-separated
# CORS_ORIGINS=https://www.yourdomain.com

# --- Stripe (optional, test mode) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# --- Gemini (only if LLM_PROVIDER=gemini) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
